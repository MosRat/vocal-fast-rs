{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vocal-fast",
  "version": "0.1.0",
  "identifier": "com.vocalfast.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "vocal-fast",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "focus": true,
        "shadow": true,
        "noRedirectionBitmap": true,
        "devtools": true,
        "zoomHotkeysEnabled": false,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splash",
        "url": "index.html#/splash",
        "title": "vocal-fast",
        "width": 430,
        "height": 270,
        "minWidth": 430,
        "minHeight": 270,
        "maxWidth": 430,
        "maxHeight": 270,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "noRedirectionBitmap": true,
        "devtools": false,
        "zoomHotkeysEnabled": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": true
      }
    ],
    "security": { "csp": null, "capabilities": ["default"] }
  },
  "bundle": { "active": false }
}
